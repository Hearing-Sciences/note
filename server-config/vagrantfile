Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.network "forwarded_port", guest: 80, host: 5000
  config.vm.provider "virtualbox" do |v|
    v.name = "NOTE-SERVER"
    v.memory = 768
    v.cpus = 2
    v.customize ["modifyvm", :id, "--cableconnected1", "on"]
  end
 
  config.vm.synced_folder "C:/NOTE", "/var/www/html/note/",
    owner: "www-data", group: "www-data", mount_options: ["dmode=775,fmode=664"]

  config.vm.provision "shell", inline: <<-SHELL
    apt-get update
    apt purge apache2
    apt-get upgrade -y
    apt-get autoremove -y
    apt-get install -y nginx php-fpm php-sqlite3
    cp /var/www/html/note/server-config/nginx/nginx.conf /etc/nginx/sites-available/default
    systemctl restart nginx
  SHELL
end
