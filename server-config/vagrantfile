Vagrant.configure("2") do |config|
  config.vm.box = "geerlingguy/ubuntu2004"
  config.vm.network "forwarded_port", guest: 80, host: 5000
  config.vm.provider "virtualbox" do |v|
    v.name = "NOTE-SERVER"
    v.memory = 512
    v.cpus = 2
  end

  config.vm.synced_folder "C:/NOTE", "/var/www/html/note/",
    owner: "www-data", group: "www-data", mount_options: ["dmode=775,fmode=664"]

  config.vm.provision "shell", inline: <<-SHELL
    apt-get update
    apt-get upgrade -y
    apt-get autoremove -y
    apt-get install -y git apache2 php sqlite php-sqlite3
    cp /var/www/html/note/server-config/apache/note.conf /etc/apache2/sites-available/000-default.conf
    a2enmod rewrite
    apache2ctl restart
  SHELL
end